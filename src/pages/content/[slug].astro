---
import SiteLayout from '../../layouts/SiteLayout.astro'; import ContentCard from '../../components/ContentCard.astro'; import MarkdownBody from '../../components/MarkdownBody.astro'; import {loadSiteData,formatDate} from '../../lib/data';
import { formatEvidenceStatus } from '../../components/labels';
const data=loadSiteData(); const item=data.content.find(x=>x.slug===Astro.params.slug); if(!item) Astro.response.status=404; const related=item?data.content.filter(x=>item.relatedIds.includes(x.id)||item.relatedIds.includes(x.slug)).slice(0,3):[]; const environment=item?.environment||[];
---
<SiteLayout title={item?.title||'자료를 찾을 수 없습니다'} description={item?.summary||'요청한 자료를 찾을 수 없습니다.'} canonical={Astro.url.pathname}>{item?<article class="wrap"><header class="page-intro"><div class="eyebrow">{item.kind} · {formatEvidenceStatus(item.evidenceStatus)}</div><h1>{item.title}</h1><p>{item.summary}</p><div class="meta-row" style="margin-top:14px"><span>원문 게시일 {formatDate(item.publishedAt)}</span><span>갱신일 {formatDate(item.updatedAt)}</span><span>{item.sourceName}</span></div></header><div class="split"><div><MarkdownBody body={item.body}/><p class="notice">이 페이지는 출처를 바탕으로 정리한 자료입니다. 원문의 작성자와 R9700 Hub의 설명을 구분해 주세요.</p><div class="section-head"><h2>이 내용이 도움이 되었나요?</h2></div><div class="toolbar"><button class="button" data-feedback="helpful">도움이 됐어요</button><button class="button" data-feedback="missing-context">보충 설명이 필요해요</button><span id="feedback-status" class="source-link" aria-live="polite"></span></div>{related.length>0&&<><div class="section-head"><h2>관련 자료</h2></div><div class="grid">{related.map(x=><ContentCard item={x}/>)}</div></>}</div><aside class="card"><div class="eyebrow">SOURCE</div><h3>{item.sourceName}</h3><p>근거 상태: {formatEvidenceStatus(item.evidenceStatus)}</p><p>원문 게시일: {formatDate(item.publishedAt)}<br/>마지막 갱신: {formatDate(item.updatedAt)}</p>{environment.length>0&&<div class="tag-row">{environment.map((x:string)=><span class="tag">{x}</span>)}</div>}<p style="margin-top:18px"><a class="button" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">원문 읽기 ↗</a></p><a class="source-link" href="/requests">정정·자료 제보</a></aside></div></article>:<div class="wrap empty"><strong>자료를 찾을 수 없습니다.</strong><a href="/search">검색으로 돌아가기</a></div>}<script is:inline>
(()=>{document.querySelectorAll('[data-feedback]').forEach(b=>b.addEventListener('click',async()=>{const out=document.getElementById('feedback-status');b.disabled=true;try{const r=await fetch('/api/feedback',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:location.pathname,kind:b.dataset.feedback})});const d=await r.json();out.textContent=r.ok?(d.message||'의견을 받았습니다.'):(d.error||'잠시 후 다시 시도해 주세요.')}catch{out.textContent='의견을 전송할 수 없습니다.'}finally{b.disabled=false}}))})();
</script></SiteLayout>
