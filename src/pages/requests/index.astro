---
import SiteLayout from '../../layouts/SiteLayout.astro'; import PageIntro from '../../components/PageIntro.astro';
---
<SiteLayout title="자료 제보와 정정 요청"><div class="wrap"><PageIntro eyebrow="SUBMIT A SOURCE" title="자료 제보" description="R9700 관련 소식, 리뷰, 작품, 정정 요청을 보내 주세요. 공개 전에 출처·권한·내용을 확인합니다."/><form id="request-form" class="card" style="max-width:760px"><div class="grid two"><label class="field">요청 유형<select name="type" required><option value="">선택해 주세요</option><option value="showcase">작품 제보</option><option value="correction">정정 요청</option></select></label><label class="field">제목<input name="title" required maxlength="160"/></label><label class="field">자료 URL<input name="url" type="url" required maxlength="2048" placeholder="https://"/></label><label class="field">제작자 또는 출처<input name="creator" required maxlength="160"/></label><label class="field">게시 권한<input name="rights" required maxlength="500" placeholder="원작자, 라이선스 또는 허용된 링크"/></label><label class="field">제작 근거<input name="evidence" required maxlength="500" placeholder="직접 실행, 제작자 보고, 또는 정정 근거"/></label><label class="field" style="grid-column:1/-1">추가 설명<textarea name="notes" maxlength="2000"></textarea></label></div><p class="source-link">첨부 파일이나 모델 워크플로는 받지 않습니다. 자료가 자동 공개되지는 않습니다.</p><button class="button primary" type="submit">제보 보내기</button><p id="request-state" role="status" aria-live="polite"></p></form></div><script is:inline>
(()=>{const form=document.getElementById('request-form'),state=document.getElementById('request-state');form.addEventListener('submit',async e=>{e.preventDefault();state.textContent='전송 중…';const payload=Object.fromEntries(new FormData(form).entries());try{const res=await fetch('/api/submit',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok||!data.ok)throw new Error(data.error||'제보를 접수할 수 없습니다.');state.textContent=data.message||'제보를 접수했습니다.';form.reset()}catch(err){state.textContent=err.message||'전송할 수 없습니다. 잠시 후 다시 시도해 주세요.'}})})();
</script></SiteLayout>
