---
import SiteLayout from '../../layouts/SiteLayout.astro'; import PageIntro from '../../components/PageIntro.astro'; import {loadSiteData,formatDate} from '../../lib/data';
const data=loadSiteData(); const ops=data.operations; const verified=data.sources.filter(s=>s.automationVerified).length;
---
<SiteLayout title="출처 및 운영 현황"><div class="wrap"><PageIntro eyebrow="SOURCES & OPERATIONS" title="출처 현황" description="출처 등록 상태와 공개 파이프라인의 요약 정보입니다. 최초 확인 또는 등록은 자동 수집 성공을 뜻하지 않습니다."/><div class="grid three"><div class="card"><div class="eyebrow">REGISTERED SOURCES</div><div class="price-amount">{ops.sourceCount||data.sources.length}</div><p>등록 출처</p></div><div class="card"><div class="eyebrow">AUTOMATION VERIFIED</div><div class="price-amount">{verified}</div><p>자동화 검증 완료 출처</p></div><div class="card"><div class="eyebrow">PIPELINE STATE</div><div class="price-amount" style="font-size:20px">{ops.state||'상태 미상'}</div><p>마지막 실행 {formatDate(ops.lastRunAt)} · 마지막 성공 {formatDate(ops.lastSuccessAt)}</p></div></div>{ops.notices.length>0&&<div class="notice" style="margin:20px 0">{ops.notices.map(n=><div>{n}</div>)}</div>}<div class="section-head"><h2>등록된 출처</h2><span class="meta">{data.sources.length} SOURCES</span></div>{data.sources.length?<div class="table-wrap"><table><thead><tr><th>출처</th><th>종류</th><th>분류</th><th>상태</th><th>자동 수집</th></tr></thead><tbody>{data.sources.map(s=><tr><td><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name} ↗</a></td><td>{s.resourceKind||'미분류'}</td><td>{s.category}</td><td>{s.status}</td><td>{s.automationVerified?'검증 완료':'검증 안 됨'}</td></tr>)}</tbody></table></div>:<div class="empty"><strong>등록된 출처가 없습니다.</strong>출처 목록이 제공되면 상태를 표시합니다.</div>}<p class="source-link" style="margin-top:18px">다음 실행 예정: {formatDate(ops.nextRunAt)} · 정보 생성: {formatDate(data.generatedAt)}</p></div></SiteLayout>
