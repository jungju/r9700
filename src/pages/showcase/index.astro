---
import SiteLayout from '../../layouts/SiteLayout.astro'; import PageIntro from '../../components/PageIntro.astro'; import {loadSiteData,formatDate} from '../../lib/data'; import {formatProvenance} from '../../components/labels';
const items=loadSiteData().showcase; const safe=items.map(x=>({id:x.id,title:x.title,type:x.type,url:x.url,poster:x.poster||'',description:x.description,provenance:x.provenance,provenanceLabel:formatProvenance(x.provenance),model:x.model||'모델 미상',tool:x.tool||'도구 미상',gpuCount:x.gpuCount||0,createdAt:formatDate(x.createdAt),sourceUrl:x.sourceUrl||'',rights:x.rights,metadata:x.metadata||{}}));
---
<SiteLayout title="R9700 작품 갤러리"><div class="wrap"><PageIntro eyebrow="SHOWCASE" title="작품 갤러리" description="R9700 제작 근거와 사용 보고를 구분합니다. 공개 권한 및 제작 조건이 확인된 결과만 등록합니다."/><div class="toolbar" role="group" aria-label="작품 유형 필터"><button class="button active" data-tab="all">전체</button><button class="button" data-tab="image">이미지</button><button class="button" data-tab="video">영상</button><label class="field">제작 근거<select id="prov"><option value="">모든 근거</option><option value="verified-local-run">직접 실행 확인</option><option value="creator-reported">제작자 사용 보고</option><option value="unverified-reference">참고 자료</option></select></label><label class="field">게시 권한<input id="rights" type="search" placeholder="권한 또는 라이선스"/></label><label class="field">GPU 수<select id="gpu"><option value="">모든 구성</option><option value="1">단일 GPU</option><option value="2">다중 GPU</option></select></label></div><div class="showcase-grid" id="gallery" data-items={JSON.stringify(safe)} aria-live="polite"></div><div class="empty" id="gallery-empty" hidden><strong>현재 조건에 맞는 작품이 없습니다.</strong>실제 R9700 결과물이 등록되면 이미지와 영상이 이곳에 추가됩니다.</div><dialog id="viewer" aria-label="작품 미리 보기" style="max-width:min(92vw,900px);border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:16px"><form method="dialog" style="text-align:right"><button class="button">닫기</button></form><div id="viewer-content"></div><p id="viewer-caption"></p></dialog></div><script is:inline>
(()=>{const el=document.getElementById('gallery');if(!el)return;const rows=JSON.parse(el.dataset.items||'[]'),dialog=document.getElementById('viewer'),v=document.getElementById('viewer-content'),cap=document.getElementById('viewer-caption');let tab='all';for(const [key,labelText] of [['model','모델'],['tool','도구']]){const label=document.createElement('label');label.className='field';label.textContent=labelText;const select=document.createElement('select');select.id=key+'-filter';select.append(new Option('모두 보기',''));for(const value of [...new Set(rows.map(x=>x[key]))].sort())select.append(new Option(value,value));label.append(select);document.querySelector('.toolbar').append(label);select.addEventListener('change',()=>draw())}function make(x){const card=document.createElement('article');card.className='showcase-item';card.dataset.type=x.type;const visual=document.createElement('div');visual.className='showcase-visual';if(x.type==='image'){const btn=document.createElement('button');btn.type='button';btn.className='icon-btn';btn.setAttribute('aria-label','이미지 확대: '+x.title);btn.style.width='100%';btn.style.height='100%';if(x.url){const img=document.createElement('img');img.src=x.url;img.alt=x.title;img.loading='lazy';btn.append(img)}else btn.textContent='이미지 미리 보기 없음';btn.addEventListener('click',()=>{if(!x.url)return;const img=document.createElement('img');img.src=x.url;img.alt=x.title;img.style.maxHeight='72vh';img.style.display='block';img.style.margin='auto';v.replaceChildren(img);cap.textContent=x.title+' · '+x.rights;dialog.showModal()});visual.append(btn)}else{visual.style.position='relative';if(x.poster){const poster=document.createElement('img');poster.src=x.poster;poster.alt=x.title+' 영상 포스터';poster.loading='lazy';visual.append(poster)}const btn=document.createElement('button');btn.className='button';btn.type='button';btn.style.position='absolute';btn.textContent='▶ 영상 재생';btn.addEventListener('click',()=>{let embed='';try{const mediaUrl=new URL(x.url,location.origin);const host=mediaUrl.hostname;let id='';if(['www.youtube.com','youtube.com','www.youtube-nocookie.com'].includes(host))id=mediaUrl.searchParams.get('v')||mediaUrl.pathname.split('/').pop()||'';if(host==='youtu.be')id=mediaUrl.pathname.slice(1);if(/^[A-Za-z0-9_-]{11}$/.test(id))embed='https://www.youtube-nocookie.com/embed/'+id;if(['vimeo.com','www.vimeo.com','player.vimeo.com'].includes(host)){const videoId=mediaUrl.pathname.split('/').pop();if(/^[0-9]+$/.test(videoId||''))embed='https://player.vimeo.com/video/'+videoId}}catch{}if(embed){const frame=document.createElement('iframe');frame.src=embed;frame.title=x.title;frame.allow='fullscreen; picture-in-picture';frame.referrerPolicy='strict-origin-when-cross-origin';frame.style.width='100%';frame.style.aspectRatio='16/9';frame.style.border='0';frame.setAttribute('sandbox','allow-scripts allow-same-origin allow-presentation');v.replaceChildren(frame)}else{const video=document.createElement('video');video.controls=true;video.autoplay=true;video.preload='none';video.playsInline=true;video.src=x.url;if(x.poster)video.poster=x.poster;video.style.maxHeight='72vh';v.replaceChildren(video)}cap.textContent=x.title+' · '+x.rights;dialog.showModal()});visual.append(btn)}const info=document.createElement('div');info.className='showcase-info';const title=document.createElement('strong');title.textContent=x.title;const p=document.createElement('p');p.textContent=x.description;const meta=document.createElement('div');meta.className='meta-row';meta.textContent=x.provenanceLabel+' · '+x.model+' · '+x.tool+(x.gpuCount?' · GPU '+x.gpuCount+'개':'');info.append(title,p,meta);const right=document.createElement('div');right.className='meta-row';right.textContent='권한: '+x.rights;info.append(right);const details=document.createElement('details');const summary=document.createElement('summary');summary.textContent='제작 환경 보기';details.append(summary);const list=document.createElement('dl');for(const [key,value] of Object.entries({제작일:x.createdAt,...x.metadata})){const term=document.createElement('dt'),description=document.createElement('dd');term.textContent=key;description.textContent=String(value);description.style.overflowWrap='anywhere';list.append(term,description)}details.append(list);info.append(details);if(x.sourceUrl){const a=document.createElement('a');a.className='source-link';a.href=x.sourceUrl;a.target='_blank';a.rel='noopener noreferrer';a.textContent='원작·출처 ↗';info.append(a)}card.append(visual,info);return card}function draw(){const prov=document.getElementById('prov').value,gpu=document.getElementById('gpu').value,rights=document.getElementById('rights').value.trim().toLowerCase();const selectedModel=document.getElementById('model-filter').value,selectedTool=document.getElementById('tool-filter').value;const found=rows.filter(x=>(!selectedModel||x.model===selectedModel)&&(!selectedTool||x.tool===selectedTool)&&(tab==='all'||x.type===tab)&&(!prov||x.provenance===prov)&&(!gpu||(gpu==='1'?x.gpuCount===1:x.gpuCount>1))&&(!rights||x.rights.toLowerCase().includes(rights)));el.replaceChildren(...found.map(make));document.getElementById('gallery-empty').hidden=found.length>0}document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{tab=b.dataset.tab;document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));draw()}));document.getElementById('prov').addEventListener('change',draw);document.getElementById('gpu').addEventListener('change',draw);document.getElementById('rights').addEventListener('input',draw);dialog.addEventListener('close',()=>{const video=v.querySelector('video');if(video){video.pause();video.removeAttribute('src');video.load()}v.replaceChildren()});draw()})();
</script></SiteLayout>
